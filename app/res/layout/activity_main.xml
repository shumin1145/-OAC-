<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_top_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_open_drawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:text="≡"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TopBarText"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />

            <TextView
                android:id="@+id/tv_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_drawer_title"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="100dp"
                android:paddingLeft="4dp"
                android:paddingRight="8dp" />

            <Button
                android:id="@+id/btn_new_chat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:text="+"
                android:padding="0dp" />
        </LinearLayout>

        <!-- 消息列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:stackFromBottom="true"
                android:transcriptMode="normal"
                android:cacheColorHint="#00000000"
                android:scrollingCache="true"
                android:smoothScrollbar="true" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/empty_chat"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_input"
            android:padding="6dp">

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_input"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:minHeight="38dp"
                android:maxLines="4"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="top|left" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_send"
                android:text="@string/btn_send"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:minWidth="56dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 侧边栏遮罩 -->
    <View
        android:id="@+id/mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- 侧边栏 -->
    <include
        android:id="@+id/drawer"
        layout="@layout/drawer_conversations"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="left" />

</FrameLayout>
