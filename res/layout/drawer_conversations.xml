<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="left"
    android:orientation="vertical"
    android:background="@drawable/bg_drawer"
    android:visibility="gone">

    <!-- 侧边栏顶部标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/item_drawer_active"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drawer_title"
            android:textColor="@color/text_drawer_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_drawer_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:textColor="@color/text_drawer_title"
            android:textSize="18sp"
            android:text="×"
            android:padding="0dp" />
    </LinearLayout>

    <!-- 当前模型显示 -->
    <LinearLayout
        android:id="@+id/btn_drawer_active_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/item_drawer_action_selector"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_active_model"
            android:textColor="@color/text_drawer_title"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_drawer_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_drawer_active"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingLeft="6dp"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_dark" />

    <!-- 对话列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/divider_dark"
            android:dividerHeight="1dp"
            android:cacheColorHint="#00000000"
            android:listSelector="@drawable/item_drawer_selector" />

        <TextView
            android:id="@+id/tv_drawer_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_conversations"
            android:textColor="@color/text_drawer_title"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_dark" />

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_drawer_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/item_drawer_action_selector"
            android:text="@string/action_new"
            android:textColor="@color/text_drawer_item"
            android:textSize="13sp"
            android:padding="12dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/divider_dark" />

        <Button
            android:id="@+id/btn_drawer_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/item_drawer_action_selector"
            android:text="@string/action_clear"
            android:textColor="@color/text_drawer_item"
            android:textSize="13sp"
            android:padding="12dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/divider_dark" />

        <Button
            android:id="@+id/btn_drawer_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/item_drawer_action_selector"
            android:text="@string/action_settings"
            android:textColor="@color/text_drawer_item"
            android:textSize="13sp"
            android:padding="12dp" />
    </LinearLayout>
</LinearLayout>
